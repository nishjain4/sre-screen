# Base URL of the Bot Svc SRE API. Leave empty to use the Vite development proxy.
VITE_API_BASE_URL=

# Optional API key. Sent as the X-API-Key header, and as ?api_key= on the
# SSE (EventSource) URL because EventSource cannot set headers.
# NOTE: values prefixed with VITE_ are embedded in the built JS bundle.
VITE_API_KEY=

# Where the Vite dev server proxies /api, /mcp and /docs.
VITE_PROXY_TARGET=http://localhost:8000
