# Amazon Bedrock; boto3 reads credentials from environment, profiles, or IAM roles.
LLM_PROVIDER=offline
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
AWS_REGION=ap-south-1
# Set these only when not using an AWS profile or IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

ORCHESTRATOR=native
# Follow-up chat context budget; report synthesis keeps all collected evidence.
LLM_MAX_CONTEXT_CHARS=16000

# Leave empty to disable API-key authentication. If set, also set VITE_API_KEY in frontend/.env.local.
API_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

LOG_LEVEL=INFO
MAX_CONCURRENT_INVESTIGATIONS=5
TOOL_TIMEOUT_SECONDS=30
SKILL_TIMEOUT_SECONDS=120
TOOL_CONCURRENCY=6
MAX_AUTO_SKILLS=8

# Repository scope and credentials forwarded to the bundled HTTP Gitea MCP server.
# Start gitea_mcp/gitea_mcp_server.py separately at http://localhost:8001/mcp.
GITEA_URL=
GITEA_TOKEN=
GITEA_OWNER=
GITEA_REPO=